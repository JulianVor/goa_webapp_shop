# Copy to ".env" and adjust before running "docker compose up".

# Two DIFFERENT networks, usually - don't assume they're the same:
#   docker inspect <goa_webapp-app-container> --format '{{range $n,$c := .NetworkSettings.Networks}}{{$n}}{{"\n"}}{{end}}'
#   docker inspect <goa_webapp-db-container> --format '{{range $n,$c := .NetworkSettings.Networks}}{{$n}}{{"\n"}}{{end}}'
# The app container is typically on both a Caddy-facing network AND Compose's own
# per-project network (which is also where its Postgres container sits) - the db
# container is usually only on the latter.
PROXY_NETWORK_NAME=fotosvorju-proxy
DB_NETWORK_NAME=life_webapp_default

# This app's own, small Postgres database (just ShopSettings: Impressum/AGB/Widerruf/
# Datenschutz/maintenance mode - NOT products, those live entirely in Medusa). Create it
# once on the shared Postgres container before first start, e.g.:
#   docker exec -it <postgres-container> psql -U goa -c \
#     "CREATE USER life_webapp_shop WITH PASSWORD 'change-me'; CREATE DATABASE life_webapp_shop OWNER life_webapp_shop;"
# SHOP_DB_HOST is the Postgres container's own name (from `docker ps`), not a Compose
# service alias - this app isn't part of that other project's compose file. DB name/user
# follow the same life_webapp_shop naming as the deployment directory and containers.
SHOP_DB_HOST=life_webapp-db-1
SHOP_DB_NAME=life_webapp_shop
SHOP_DB_USER=life_webapp_shop
SHOP_DB_PASSWORD=change-me

# This app's own small admin area (shop texts/legal pages/maintenance toggle) -
# unrelated to Medusa's own admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Where the Medusa backend (goa_webapp_shop_admin) is reachable from this container -
# usually its Docker Compose service name if both stacks share SHARED_NETWORK_NAME.
MEDUSA_STORE_API_URL=http://medusa:9000
# Public URL of the Medusa Admin Dashboard, for the "Produkte verwalten" link in this
# app's own admin area.
MEDUSA_ADMIN_URL=https://shop-admin.heimfeld.life/app
# From the Medusa Admin: Settings > Publishable API Keys, scoped to the sales channel
# this storefront should read from. Required - Store API calls fail without it.
MEDUSA_PUBLISHABLE_API_KEY=
# ISO 3166-1 alpha-2 country code used to resolve which Medusa region (currency/pricing/
# tax) anonymous storefront visitors see.
MEDUSA_DEFAULT_COUNTRY_CODE=de

SHOP_APP_PORT=8081

# Caches parsed Thymeleaf templates instead of re-parsing them on every request. Leave at
# "true" in production; "false" only for local dev if you want template edits to show up
# without a restart.
#THYMELEAF_CACHE=true
